{
  "name": "tubeglot",
  "version": "0.1.0",
  "description": "Personal-first, open-source YouTube metadata and subtitle localization helper",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thaaan184/YTmetadataTL.git"
  },
  "keywords": [
    "youtube",
    "localization",
    "subtitles",
    "srt",
    "vtt",
    "metadata",
    "chrome-extension",
    "wxt"
  ],
  "author": "Thaaan184",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Thaaan184/YTmetadataTL/issues"
  },
  "homepage": "https://github.com/Thaaan184/YTmetadataTL#readme",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
