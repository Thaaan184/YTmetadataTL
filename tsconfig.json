{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["chrome", "node"]
  },
  "include": [
    "core/**/*",
    "entrypoints/**/*",
    "components/**/*",
    "tests/**/*",
    "wxt.config.ts",
    "vitest.config.ts"
  ]
}
